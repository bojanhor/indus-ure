#!/usr/bin/env bash
set -euo pipefail

release="${1:-}"
base="/opt/indus-ure"
staging="/tmp/indus-ure-${release}-deploy"
destination="$base/releases/$release"
current="$base/current"

if [[ ! "$release" =~ ^[0-9a-f]{7,40}$ ]]; then
  echo "Neveljavna oznaka izdaje." >&2
  exit 2
fi

previous="$(readlink -f "$current" 2>/dev/null || true)"

# Serialize deployments, including the verified backup and checkpoint marker.
exec 9>/run/lock/indus-ure-deploy.lock
flock -n 9 || { echo "Druga objava že poteka." >&2; exit 7; }

# Do not publish an untested snapshot-store implementation, even when this
# command is called manually rather than through deploy.ps1.
candidate="$destination"
[[ -d "$candidate" ]] || candidate="$staging"
proof="/var/lib/indus-ure/qa/$release.sha256"
if [[ ! -f "$proof" || -L "$proof" || "$(stat -c %U "$proof")" != root ]]; then
  echo "Manjka obvezno PostgreSQL QA/restore dokazilo za to izdajo." >&2
  exit 5
fi
actual="$(cd "$candidate" && find outputs scripts tests package.json package-lock.json -type f -print0 | sort -z | xargs -0 sha256sum | sha256sum | awk '{print $1}')"
[[ "$actual" == "$(cat "$proof")" ]] || { echo "QA dokazilo ne pripada vsebini kandidata." >&2; exit 5; }

# Verified off-site recovery snapshot before the production switch.
# Wait for an existing scheduled run, then request a fresh deployment copy.
while [[ "$(systemctl show indus-ure-backup.service -p ActiveState --value)" =~ ^(active|activating|deactivating)$ ]]; do sleep 1; done
backup_started="$(date +%s)"
systemctl start indus-ure-backup.service
[[ "$(systemctl show indus-ure-backup.service -p Result --value)" == success ]] || exit 6
checkpoint_tool="$candidate/scripts/mark-backup-deployment.js"
# A code rollback can target a release from before checkpoint marking existed.
[[ -f "$checkpoint_tool" ]] || checkpoint_tool="$current/scripts/mark-backup-deployment.js"
if [[ -f "$checkpoint_tool" ]]; then
  node "$checkpoint_tool" --env-file /etc/indus-ure.env --release "$release" --since "$backup_started"
else
  echo "Stari izdaji nimata označevalnika kopij; preverjena recovery kopija ostane po njunem pravilu hrambe." >&2
fi

if [[ ! -d "$destination" ]]; then
  if [[ ! -d "$staging" || -L "$staging" ]]; then
    echo "Pripravljena izdaja ne obstaja." >&2
    exit 3
  fi
  if [[ "$(realpath "$staging")" != "$staging" ]]; then
    echo "Neveljavna pot pripravljene izdaje." >&2
    exit 3
  fi
  if [[ ! -f "$staging/package.json" || ! -f "$staging/outputs/server.js" ]]; then
    echo "Pripravljena izdaja nima obveznih datotek." >&2
    exit 3
  fi

  mv "$staging" "$destination"
  chown -R root:root "$destination"
fi

# Pripravljalna korenska mapa je 0700; systemd uporabnik mora vanjo vstopiti.
chmod 0755 "$destination"

temporary_link="$base/.current-$release"
rm -f "$temporary_link"
ln -s "$destination" "$temporary_link"
mv -Tf "$temporary_link" "$current"

restart_ok=true
systemctl restart indus-ure || restart_ok=false
sleep 2
if [[ "$restart_ok" != true ]] || ! systemctl is-active --quiet indus-ure \
    || ! curl --fail --silent --retry 8 --retry-connrefused --retry-delay 1 http://127.0.0.1:8123/api/health >/dev/null; then
  if [[ -n "$previous" && -d "$previous" ]]; then
    ln -sfn "$previous" "$current"
    systemctl restart indus-ure
  fi
  echo "Zagon nove izdaje ni uspel; povrnjena je prejšnja izdaja." >&2
  exit 4
fi

echo "Aktivna izdaja: $release"
