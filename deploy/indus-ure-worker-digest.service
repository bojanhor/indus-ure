[Unit]
Description=Send INDUS URE daily worker HTML reports to owner
After=network-online.target postgresql.service indus-ure.service
Wants=network-online.target
Requires=postgresql.service
StartLimitIntervalSec=12h
StartLimitBurst=12

[Service]
Type=oneshot
User=indus-ure
Group=indus-ure
WorkingDirectory=/opt/indus-ure/current
EnvironmentFile=/etc/indus-ure.env
ExecStart=/usr/local/sbin/indus-ure-worker-digest
Restart=on-failure
RestartSec=15min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/indus-ure
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6